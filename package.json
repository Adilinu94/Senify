{
  "name": "senify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Senify — agent-native website platform (local program)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx packages/mcp/src/cli.ts start",
    "senify": "tsx packages/mcp/src/cli.ts",
    "route-matrix": "tsx packages/engine/scripts/route-matrix.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "node scripts/verify-visual.mjs",
    "lint": "eslint packages",
    "verify": "pnpm build && pnpm lint && pnpm test",
    "verify:parity": "node scripts/verify-parity.mjs",
    "verify:import": "pnpm exec vitest run packages/framer-import/test/import-visual-gate-browser.test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.30.0",
    "@sinclair/typebox": "^0.34.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "commander": "^14.0.0",
    "eslint": "^9.30.0",
    "pg-mem": "^3.0.5",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.33.2"
}
