{
  "name": "senify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Senify — agent-native website platform (local program)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx packages/mcp/src/cli.ts start",
    "senify": "tsx packages/mcp/src/cli.ts",
    "route-matrix": "tsx packages/engine/scripts/route-matrix.ts",
    "route-matrix:check": "tsx packages/engine/scripts/route-matrix.ts --check",
    "thumbnails:generate": "tsx packages/editor/scripts/generate-section-thumbnails.ts",
    "build": "pnpm typecheck && pnpm -r build",
    "build:app": "pnpm --filter @senify/app build",
    "build:docs": "pnpm --filter @senify/docs-portal build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage packages/engine/test packages/editor/test packages/mcp/test && node scripts/render-quality.mjs --stamp",
    "test:postgres": "node scripts/verify-postgres.mjs",
    "test:visual": "node scripts/verify-visual.mjs",
    "lint": "eslint packages scripts eslint.config.mjs",
    "deps:check": "depcruise --config .dependency-cruiser.js packages --output-type err",
    "check:patch": "git diff --check",
    "verify:dist": "node scripts/verify-dist.mjs",
    "quality:render": "node scripts/render-quality.mjs",
    "quality:check": "node scripts/render-quality.mjs --check",
    "quality:stamp": "node scripts/render-quality.mjs --stamp",
    "manifest:render": "node scripts/render-manifest.mjs",
    "manifest:check": "node scripts/render-manifest.mjs --check",
    "verify": "pnpm build && pnpm verify:dist && pnpm lint && pnpm deps:check && pnpm check:patch && pnpm test",
    "verify:parity": "node scripts/verify-parity.mjs",
    "verify:import": "pnpm exec vitest run packages/framer-import/test/import-visual-gate-browser.test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.39.5",
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "3.2.7",
    "commander": "^14.0.3",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.5",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "//": "Die Elternpakete pinnen diese Abhaengigkeiten auf genau die Version, die die Advisory betrifft. Die Overrides heben die Pin auf die gepatchte Version - die jeweils naechste, kein Sprung ueber eine Hauptversion hinaus (OSV-Scan, 20.10.2026). `playwright-core` ist eine Ausnahme: @axe-core/playwright loest seinen Peer gegen die NEUESTE passende Version auf, und zwei Playwright-Versionen im Baum ergeben zwei verschiedene `Page`-Typen (TypeScript-Fehler TS2739 in den Browser-Tests).",
    "overrides": {
      "devalue": "5.9.3",
      "hono": "4.13.11",
      "playwright-core": "1.63.0",
      "sharp": "0.35.5",
      "smol-toml": "1.9.0",
      "vite": "8.3.3",
      "source-map-js": "1.2.2"
    }
  },
  "packageManager": "pnpm@10.33.2"
}
