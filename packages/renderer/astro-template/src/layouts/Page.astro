---
import Section from "../components/Section.astro";
import type { SectionContext } from "@senify/registry/components";
import "../styles/global.css";

type Props = {
  page: {
    path: string;
    title: string;
    description?: string;
    ogImage?: string;
    // The language of the page root, when it is a valid tag; the site default applies otherwise.
    lang?: string;
    tree: { rootNodeId: string; nodes: Record<string, unknown> };
    motion: string;
    // The page-level View Transition block (M6), null without the preset.
    pageTransition: string | null;
    // The pure-CSS blocks: the effects (hover-lift, ambient-float, grain) and
    // the reveals that enter above the fold without the page script. Null
    // without any.
    motionCss: string | null;
    // preloader-light: the page renders the loading curtain.
    hasPreloader: boolean;
    jsonLd: string | null;
    flags: {
      hasMotion: boolean;
      needsScrollTrigger: boolean;
      needsSplitText: boolean;
      hasLenis: boolean;
      hasPending: boolean;
      islands: string[];
      hasForm: boolean;
    };
  };
  site: { name: string; baseUrl: string; lang?: string };
  ctx: SectionContext;
  // The bake only writes assets/sections.css when a page carries style
  // overrides; a missing file must not be linked (it would 404).
  sectionsCss?: boolean;
  // The site-wide style rules (ADR-0005), written when the registry has rules.
  // Linked at the end of the body, after the widget base stylesheet: both sit
  // in `@layer user-authored` and the base must stay the weaker stage — the
  // same order the canvas frame compiles (base, then authored rules).
  styleRulesCss?: boolean;
  fontPreloads: { href: string }[];
  // Self-hosted motion runtime (ticket 19, M2): local files the bake copies
  // next to the other assets — no CDN request, version frozen in the lockfile.
  vendor: { gsap: string; scrollTrigger: string; splitText: string; lenis: string };
};

const {
  page,
  site,
  ctx,
  sectionsCss = false,
  styleRulesCss = false,
  fontPreloads,
  vendor,
} = Astro.props;
const lang = page.lang ?? site.lang ?? "de";
// Crawlers and link previews fetch og:image without the page as context, so a
// site-relative path is made absolute against the public address. The meta
// value is free text, so one that cannot be resolved stays as written instead
// of failing the bake.
const ogImage = (() => {
  if (!page.ogImage) return undefined;
  try {
    return new URL(page.ogImage, site.baseUrl).href;
  } catch {
    return page.ogImage;
  }
})();

// FOUC guard (payload-spec.md §3): the render paths stamp
// `data-motion-pending` on nodes whose preset hides them until the page script
// runs. The inline failsafe survives a broken page.js; <noscript> is the only
// correct !important — without JS the content must be visible.
const PENDING_CSS = "[data-motion-pending]{opacity:0}";
const PENDING_NOSCRIPT = "[data-motion-pending]{opacity:1 !important}";
const PENDING_FAILSAFE =
  'setTimeout(function(){var pending=document.querySelectorAll("[data-motion-pending]");for(var index=0;index<pending.length;index+=1){pending[index].removeAttribute("data-motion-pending");}},1600);';

// A page whose only motion is a CSS entry has nothing for the page script to
// play, but the site's smooth-scroll profile still applies to it. Deferred
// script tags would compete with fonts and CSS on a slow link and push the LCP
// out (measured: +660 ms on Slow 4G with a 4x CPU throttle), so Lenis and the
// page script load after the `load` event, when the browser is idle. The
// loader sits at the end of the body: an inline script in the head waits for
// the stylesheets before it and holds back the parse of the content.
const lenisLateLoader = (lenisSrc: string): string =>
  `window.addEventListener("load",function(){var run=function(){var lenis=document.createElement("script");lenis.src=${JSON.stringify(lenisSrc)};lenis.onload=function(){var page=document.createElement("script");page.src="/assets/page.js";document.body.appendChild(page);};document.body.appendChild(lenis);};if("requestIdleCallback" in window){window.requestIdleCallback(run);}else{setTimeout(run,200);}});`;

// preloader-light (M6): the curtain is part of the markup, so the first paint
// never flashes the content; the inline script removes it on load, at the
// 2.5 s cap (soft budget) or instantly under reduced motion. Without JS the
// <noscript> block hides it — it must never become the page.
const PRELOADER_CSS =
  ".senify-preloader{position:fixed;inset:0;z-index:9998;background:var(--bg-base,#ffffff);opacity:1;transition:opacity .4s ease;pointer-events:none;}";
const PRELOADER_NOSCRIPT = ".senify-preloader{display:none}";
const PRELOADER_SCRIPT =
  '(function(){var preloader=document.querySelector("[data-preloader]");if(!preloader)return;var reduce=window.matchMedia("(prefers-reduced-motion: reduce)").matches;var done=function(){if(!preloader.parentNode)return;if(reduce){preloader.remove();return;}preloader.style.opacity="0";setTimeout(function(){preloader.remove();},450);};if(document.readyState==="complete")done();else window.addEventListener("load",done);setTimeout(done,2500);})();';
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title} | {site.name}</title>
    {page.description && <meta name="description" content={page.description} />}
    <meta property="og:title" content={page.title} />
    {page.description && <meta property="og:description" content={page.description} />}
    <meta property="og:url" content={`${site.baseUrl}${page.path}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <link rel="canonical" href={`${site.baseUrl}${page.path}`} />
    <link rel="stylesheet" href="/assets/theme.css" />
    {sectionsCss && <link rel="stylesheet" href="/assets/sections.css" />}
    {fontPreloads.map((font) => (
      <link
        rel="preload"
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
        href={font.href}
      />
    ))}
    {page.jsonLd && <script type="application/ld+json" set:html={page.jsonLd} />}
    {page.pageTransition && <style is:inline set:html={page.pageTransition} />}
    {page.motionCss && <style is:inline set:html={page.motionCss} />}
    {page.hasPreloader && <style is:inline set:html={PRELOADER_CSS} />}
    {page.flags.hasMotion && (
      <>
        {page.flags.hasPending && <style is:inline set:html={PENDING_CSS} />}
        <script type="application/json" id="motion-data" set:html={page.motion} />
        <script src={vendor.gsap} defer />
        {page.flags.needsScrollTrigger && <script src={vendor.scrollTrigger} defer />}
        {page.flags.needsSplitText && <script src={vendor.splitText} defer />}
        {page.flags.hasLenis && <script src={vendor.lenis} defer />}
        <script src="/assets/page.js" defer />
        {page.flags.hasPending && (
          <>
            <noscript>
              <style is:inline set:html={PENDING_NOSCRIPT} />
            </noscript>
            <script is:inline set:html={PENDING_FAILSAFE} />
          </>
        )}
      </>
    )}
    {page.flags.islands.length > 0 && <script src="/assets/islands.js" defer />}
    {page.flags.hasForm && <script src="/assets/forms.js" defer />}
  </head>
  <body>
    {page.hasPreloader && (
      <>
        <div class="senify-preloader" data-preloader aria-hidden="true"></div>
        <noscript>
          <style is:inline set:html={PRELOADER_NOSCRIPT} />
        </noscript>
        <script is:inline set:html={PRELOADER_SCRIPT} />
      </>
    )}
    <Section tree={page.tree} ctx={{ ...ctx, currentPath: page.path, lang, gateEmbeds: true, cssEntry: true }} />
    {styleRulesCss && <link rel="stylesheet" href="/assets/style-rules.css" />}
    {!page.flags.hasMotion && page.flags.hasLenis && (
      <script is:inline set:html={lenisLateLoader(vendor.lenis)} />
    )}
  </body>
</html>
