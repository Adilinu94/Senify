import { writeFileSync } from "node:fs";
import { captureBrowser } from "../packages/framer-import/src/capture-browser.ts";
import { captureHtml } from "../packages/framer-import/src/capture-html.ts";
import { mergeDeviceVariants } from "../packages/framer-import/src/import.ts";
const url = "https://chocolate-attributes-385353.framer.app/";
const res = await captureBrowser({ url, pagePath: "/", settleMs: 800 });
writeFileSync(".scratch/choc-dbg-tablet.html", res.deviceMarkup?.tablet ?? "");
writeFileSync(".scratch/choc-dbg-desktop.json", JSON.stringify(res.document));
const tablet = captureHtml({ html: res.deviceMarkup!.tablet!, url, pagePath: "/" });
writeFileSync(".scratch/choc-dbg-tablet.json", JSON.stringify(tablet));
type N = { key: string; tag: string; baseClasses?: string[]; variantClasses?: string[]; htmlId?: string | null; states: any[]; children: N[]; text?: string };
const find = (n: N, pred: (n: N) => boolean, out: N[] = [], path: string[] = []): N[] => { if (pred(n)) out.push(n); for (const c of n.children) find(c, pred, out); return out; };
const pick = (n: N) => ({ key: n.key, tag: n.tag, base: n.baseClasses, variant: n.variantClasses, states: n.states.map((s: any) => ({ d: s.device, fs: s.visual?.fontSize ?? s.typography?.fontSize, keys: Object.keys(s).join(",") })) });
const has = (n: N) => (n.baseClasses ?? []).includes("framer-1uss29n");
console.log("DESKTOP", JSON.stringify(find(res.document.pages[0]!.root as N, has).map(pick)));
console.log("TABLET", JSON.stringify(find(tablet.pages[0]!.root as N, has).map(pick)));
const merged = mergeDeviceVariants(res.document, tablet, "tablet");
console.log("MERGED", JSON.stringify(find(merged.pages[0]!.root as N, has).map((n) => ({ key: n.key, states: n.states }))).slice(0, 3000));
process.exit(0);